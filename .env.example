# Prisma PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/laural_backend"

# Runtime Environment
NODE_ENV="development"  # Set to "production" in production

# RS256 JWT Keys (Base64 encoded PEM strings)
# Generate with: node scripts/generate-jwt-keys.ts
JWT_PRIVATE_KEY="base64_encoded_private_key_here"
JWT_PUBLIC_KEY="base64_encoded_public_key_here"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# Frontend / Admin URLs (used for CORS allowlist)
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# AWS S3 (Media Storage + Encrypted DB Backups)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET_NAME="laural-media-bucket"

# Grafana Loki Logging
LOKI_HOST=http://loki:3100
LOKI_AUTH=username:password

# System Routes
API_BASE_URL="http://localhost:5000"

# ─── Security ────────────────────────────────────────────────────────────────

# Slack Webhook for security alerts (brute-force, fraud, weekly audit digest)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# Cloudflare Turnstile CAPTCHA (server-side secret key)
# Get from: https://dash.cloudflare.com → Turnstile → your site → Secret Key
# Test secret (always passes): 1x0000000000000000000000000000000AA
# Test secret (always fails):  2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"

# Admin IP Whitelist (comma-separated, leave empty or "*" to allow all)
# Example: "203.0.113.10,203.0.113.20"
ADMIN_ALLOWED_IPS=""

# Encrypted DB Backup (GPG passphrase for pg_dump backups uploaded to S3)
# Store this securely — losing it means you can't decrypt your backups
BACKUP_ENCRYPTION_KEY="your_secure_gpg_passphrase_here"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Secure Redis Connection (Require Password & TLS)
REDIS_URL="rediss://default:SecurePasswordHere@redis.railway.internal:6379"
